server {
    listen 80;
    #listen [::]:80;
    server_name familyreunions.online;

    #root /usr/share/nginx/html; # Serves static files if no proxy match

    location /api {
        #proxy_redirect  http://my-family-ws:8090/  /api;
        proxy_pass http://my-family-ws:8090;
        #proxy_set_header Host $host;
        #proxy_set_header X-Real-IP $remote_addr;
        #proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        root /var/www/familyreunions.online; # Serves angular app files
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    #error_page  404  /404.html;

    # redirect server error pages to the static page /50x.html
    #error_page   500 502 503 504  /50x.html;
    #location = /50x.html {
    #    root   /usr/share/nginx/html;
    #}
}